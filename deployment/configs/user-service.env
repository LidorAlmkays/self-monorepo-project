# User service configurations
PEPPER_LETTERS="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
PEPPER_LENGTH=4

# Database configurations
DB_NAME="<db_name>"
DB_USERNAME="<db_user>"
DB_PASSWORD="<db_password>"
DB_PORT=27017
DB_IP="<mongodb_host>"

# RabbitMQ configurations
USER_EXCHANGE_NAME="user"
RABBITMQ_URL="amqp://<rabbitmq_user>:<rabbitmq_password>@<rabbitmq_host>:<rabbitmq_port>/"
 