{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/frontend/src",
  "tags": ["scope:frontend"],
  "targets": {
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "options": {
        "engine": "docker",
        "load": true,
        "metadata": {
          "images": ["frontend"],
          "tags": ["type=ref,event=branch"]
        }
      }
    }
  }
}
